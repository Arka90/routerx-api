# Copy to .env and fill in. Never commit the result — .env is gitignored, and
# the Dockerfile deliberately does not copy it into the image.

# ---- Required ----
# The process refuses to start without these.
#
# Application secret: signs nothing user-facing any more, but it is the pepper
# for login-code hashes. Generate with: openssl rand -hex 32
JWT_SECRET=

# Postgres. With docker compose, host `postgres` and the credentials below.
DATABASE_URL=postgres://routerx:CHANGE_ME@postgres:5432/routerx
# Read by the postgres service in docker-compose.yml.
POSTGRES_USER=routerx
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=routerx
# Set to true for a managed provider that requires TLS (RDS, Neon, Supabase).
DATABASE_SSL=
DATABASE_POOL_SIZE=10

# ---- Server ----
PORT=3000
NODE_ENV=production

# Public URL of the web app. Used to build invite links and the "open
# monitor" button in alerts, so it must be the address users actually visit.
APP_URL=https://app.routerx.dev

# Set when the API sits behind nginx / Cloudflare / any reverse proxy.
# Without it every request looks like it came from the proxy and the per-IP
# rate limits collapse into one shared bucket. `1` means "one proxy hop".
TRUST_PROXY=1

# Comma-separated origins allowed to call the API. Leave empty and ANY origin
# is accepted (the server warns at boot). Set it to your frontend's URL.
CORS_ORIGINS=https://app.routerx.dev

# ---- Queue ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# How many checks the monitor worker runs at once. Checks are almost entirely
# network wait, so this can be well above the core count.
WORKER_CONCURRENCY=10

# ---- Probe region ----
# Which vantage point THIS worker reports from. A worker consumes only its own
# region's queue and registers the region on startup, so a second location is
# another worker with a different REGION — see docs/MULTI-REGION.md.
# Leave as `default` for a single-region deployment.
REGION=default
REGION_NAME=Primary

# ---- Mail ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
GENERAL_FROM=

# ---- Login codes ----
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ---- Invitations ----
INVITE_TTL_HOURS=72

# ---- Retention ----
# probe_results and alert_deliveries older than this are deleted nightly.
PROBE_RETENTION_DAYS=30

# ---- Probe safety ----
# Leave unset. Setting this to "true" lets monitors, /probe AND outbound
# webhook channels reach private, loopback and link-local addresses —
# including the cloud metadata endpoint. Only for self-hosters who genuinely
# need to watch a service on their own LAN.
ALLOW_PRIVATE_PROBE_TARGETS=

# ---- Plans and quotas ----
# Off by default. Limits are reported from day one but nothing is refused
# until this is true, so you can look at real usage before switching it on.
# Workspaces that existed before quotas shipped are grandfathered regardless.
ENFORCE_QUOTAS=false

# ---- Billing (optional) ----
# Billing endpoints return 503 until STRIPE_SECRET_KEY is set; everything else
# works without it, on the free plan.
STRIPE_SECRET_KEY=
# From the Stripe dashboard's webhook endpoint. Required for the webhook to be
# accepted at all — an unsigned request is rejected.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# ---- Tests ----
# Unset, the suite runs against an in-process Postgres (PGlite) and needs no
# server. Set this to run the identical suite against a real one.
TEST_DATABASE_URL=
