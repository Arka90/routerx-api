# Copy to .env and fill in. Never commit the result — .env is gitignored, and
# the Dockerfile deliberately does not copy it into the image.

# ---- Required ----
# The process refuses to start without this. Generate with:
#   openssl rand -hex 32
JWT_SECRET=

# ---- Server ----
PORT=3000
NODE_ENV=production

# Set when the API sits behind nginx / Cloudflare / any reverse proxy.
# Without it every request looks like it came from the proxy and the per-IP
# rate limits collapse into one shared bucket. `1` means "one proxy hop".
TRUST_PROXY=1

# Comma-separated origins allowed to call the API. Leave empty and ANY origin
# is accepted (the server warns at boot). Set it to your frontend's URL.
# e.g. CORS_ORIGINS=https://app.routerx.dev,http://localhost:5173
CORS_ORIGINS=

# ---- Queue ----
REDIS_HOST=redis

# ---- Mail ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM=
GENERAL_FROM=

# ---- Login codes ----
# Defaults shown. Codes are 6 digits, stored as a keyed hash, single use.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ---- Retention ----
# probe_results rows older than this are deleted nightly. One monitor on a
# 30-second interval writes ~2,880 rows a day, so this is what keeps the
# SQLite file from growing without bound.
PROBE_RETENTION_DAYS=30

# ---- Probe safety ----
# Leave unset. Setting this to "true" lets monitors and /probe reach private,
# loopback and link-local addresses — including the cloud metadata endpoint —
# which turns the API into an SSRF gadget. Only for self-hosters who
# genuinely need to watch a service on their own LAN.
ALLOW_PRIVATE_PROBE_TARGETS=
